// bitLength/signedness/extendedAttribute are accepted but ignored: only the
// one combination AddressValueToU64 needs is implemented (32, unsigned,
// EnforceRange). See docs/hardcodes.md #13.
def ConvertToInt(
  V: Unknown,
  bitLength: Unknown,
  signedness: Unknown,
  extendedAttribute: Unknown,
): Normal[Number] | Abrupt[throw] = {
  call %0 = clo<"ToNumber">(V)
  assert (? %0: Completion)
  if (? %0: Abrupt) return %0
  else %0 = %0.Value
  let x = %0
  if (|| (|| (= x NaN) (= x +NUM_INF)) (= x -NUM_INF)) {
    call %1 = clo<"__NEW_ERROR_OBJ__">("%TypeError.prototype%")
    call %2 = clo<"ThrowCompletion">(%1)
    return %2
  }
  let m = ([math] x)
  if (< m 0) {
    call %3 = clo<"__NEW_ERROR_OBJ__">("%TypeError.prototype%")
    call %4 = clo<"ThrowCompletion">(%3)
    return %4
  }
  let n = (floor m)
  if (< 4294967295 n) {
    call %5 = clo<"__NEW_ERROR_OBJ__">("%TypeError.prototype%")
    call %6 = clo<"ThrowCompletion">(%5)
    return %6
  }
  call %7 = clo<"NormalCompletion">(n)
  return %7
}
