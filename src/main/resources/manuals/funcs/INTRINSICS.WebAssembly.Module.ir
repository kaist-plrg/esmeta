def <BUILTIN>:INTRINSICS.WebAssembly.Module(
  this: ESValue,
  ArgumentsList: List[ESValue],
  NewTarget: Record[Constructor] | Undefined,
): Unknown = {
  let __args__ = (record)
  if (< 0 (sizeof ArgumentsList)) {
    pop module < ArgumentsList
    expand __args__.module
  } else let module = undefined
  if (< 0 (sizeof ArgumentsList)) {
    pop importObject < ArgumentsList
    expand __args__.importObject
  } else let importObject = undefined
  call %0 = clo<"Module_module_importObject_">(module, importObject)
}
