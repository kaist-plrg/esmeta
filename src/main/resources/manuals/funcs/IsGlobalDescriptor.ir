def IsGlobalDescriptor(
  x: Unknown
): Unknown = {
  if (= (typeof x) @Object) {
    let map = x.__MAP__
    if (exists map.value) {
      if (exists map.mutable)
        return true
      else {
        map.mutable = (record [PropertyDescriptor] {
          "Value" : false,
          "Writable" : false,
          "Enumerable" : false,
          "Configurable" : false,
        })
        return true
      }
    }
  }
  return false
}
