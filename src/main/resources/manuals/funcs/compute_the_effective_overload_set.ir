def compute_the_effective_overload_set(
  kind: Unknown,
  A: Unknown,
  I: Unknown,
  N: Unknown,
): Unknown = {
  S = (list [])
  %0 = I.members
  %1 = 0
  while (< %1 (sizeof %0)) {
    if (= %0[%1].id A) 
      X = %0[%1]
    %1 = (+ %1 1)
  }
  assert (? X: Record[operation])
  arguments = X.params
  n = (sizeof arguments)
  %2 = 0
  types = (list [])
  optionalityValues = (list [])
  while (< %2 (sizeof arguments)) {
    push types < arguments[%2].ty
    if (= arguments[%2].optional true)
      push optionalityValues < "optional"
    else
      push optionalityValues < "required"
    %2 = (+ %2 1)
  }
  %3 = (list [X, types, optionalityValues])
  push S < %3
  i = (- n 1)
  while (&& (! (< i 0)) (= arguments[i].optional "optional")) {
    t = (list [])
    o = (list [])
    j = 0
    while (< j (- i 1)) {
      push t < types[j]
      push o < optionalityValues[j]
      j = (+ j 1)
    }
    %4 = (list [X, t, o])
    push S < %4
    i = (- i 1)
  }
  print S
  return S
}
