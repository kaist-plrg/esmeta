def converted_to_a_javascript_value(
  argument: Unknown,
): ESValue = {
  if (? argument: Map) {
    let intrinsics = @EXECUTION_STACK[0].Realm.Intrinsics
    call obj = clo<"__NEW_OBJ__">()
    obj.Prototype = intrinsics["%Object.prototype%"]
    obj.Extensible = true
    let ks = (keys argument)
    let n = (sizeof ks)
    let i = 0
    while (< i n) {
      let key = ks[i]
      let rawValue = argument[key]
      call value = clo<"converted_to_a_javascript_value">(rawValue)
      obj.__MAP__[key] = (record [PropertyDescriptor] {
        "Value" : value,
        "Writable" : true,
        "Enumerable" : true,
        "Configurable" : true,
      })
      i = (+ i 1)
    }
    return obj
  }
  return argument
}
