// dictionary cases read each declared member straight off argument's own
// __MAP__ (own data properties only -- no prototype chain, no getters, no
// required-member validation). See docs/hardcodes.md #2.
def converted_to_an_idl_value(
  argument: Unknown,
  T: Unknown
): ESValue = {
  if (= T "unsigned long") {
    let m = ([math] ([number] argument))
    if (< m 0) {
      return (% (- 0 (floor (abs m))) 4294967296)
    }
    return (% (floor m) 4294967296)
  }
  if (= T "MemoryDescriptor") {
    let d = (map[String, Unknown])
    if (exists argument.__MAP__["initial"]) {
      let pd = argument.__MAP__["initial"]
      d["initial"] = pd.Value
    } else nop
    if (exists argument.__MAP__["maximum"]) {
      let pd = argument.__MAP__["maximum"]
      d["maximum"] = pd.Value
    } else nop
    if (exists argument.__MAP__["address"]) {
      let pd = argument.__MAP__["address"]
      d["address"] = pd.Value
    } else nop
    return d
  }
  if (= T "TableDescriptor") {
    let d = (map[String, Unknown])
    if (exists argument.__MAP__["element"]) {
      let pd = argument.__MAP__["element"]
      d["element"] = pd.Value
    } else nop
    if (exists argument.__MAP__["initial"]) {
      let pd = argument.__MAP__["initial"]
      d["initial"] = pd.Value
    } else nop
    if (exists argument.__MAP__["maximum"]) {
      let pd = argument.__MAP__["maximum"]
      d["maximum"] = pd.Value
    } else nop
    if (exists argument.__MAP__["address"]) {
      let pd = argument.__MAP__["address"]
      d["address"] = pd.Value
    } else nop
    return d
  }
  if (= T "GlobalDescriptor") {
    let d = (map[String, Unknown])
    if (exists argument.__MAP__["value"]) {
      let pd = argument.__MAP__["value"]
      d["value"] = pd.Value
    } else nop
    if (exists argument.__MAP__["mutable"]) {
      let pd = argument.__MAP__["mutable"]
      d["mutable"] = pd.Value
    } else nop
    return d
  }
  return argument
}
