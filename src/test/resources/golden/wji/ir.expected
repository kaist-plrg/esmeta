    call result = clo<"a_promise_rejected_with">(reason)
  }
  call _result2 = clo<"converted_to_a_javascript_value">(result)
  if (? _result2: Completion) {
    return _result2
  } else {
    call _ret1 = clo<"NormalCompletion">(_result2)
    return _ret1
  }
}
