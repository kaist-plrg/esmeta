109 func(s)
# compile a WebAssembly module(bytes)
  let module = @module_decode(bytes)
  if (module == %error):
    return %error
  let _call1 = @module_validate(module)
  if (_call1 == %error):
    return %error
  return module

# validate builtins and imported string for a WebAssembly module(module, builtinSetNames, importedStringModule)
  let _call2 = @validate builtin set names(builtinSetNames)
  if (_call2 == false):
    return false
  !(foreach |import| in [=module_imports=](|module|))
  if ((importedStringModule != null) && (import[0] == importedStringModule)):
    let importExternType = import[2]
    let stringExternType = ?(`global const (ref extern)`)
    let _call3 = @match_externtype(stringExternType, importExternType)
    if (_call3 == false):
      return false
  else:
    if (?([=validate an import for builtins|validating an import for builtins=] with |import|) && (builtinSetNames == false)):
      return false
  return true

# validate(bytes, options)
  let stableBytes = ?(a [=get a copy of the buffer source|copy of the bytes held by the buffer=] |bytes|)
  let module = @Compile a WebAssembly module(stableBytes)
  if (module == %error):
    return false
  let builtinSetNames = options.[[builtins]]
  let importedStringModule = options.[[importedStringConstants]]
  if (?([=validate builtins and imported string for a WebAssembly module|validating builtins and imported strings=] for |module| with |builtinSetNames|) && ?(|importedStringModule| returns false)):
    return false
  return true

# construct a WebAssembly module object(module, bytes, builtinSetNames, importedStringModule)
  let moduleObject = new Module {}
  moduleObject.[[Module]] = module
  moduleObject.[[Bytes]] = bytes
  moduleObject.[[BuiltinSets]] = builtinSetNames
  moduleObject.[[ImportedStringModule]] = importedStringModule
  return moduleObject

# asynchronously compile a WebAssembly module(bytes, options, taskSource)
  let promise = @a new promise()
  let module = @compile a WebAssembly module(bytes)
  let _ = @Queue a task(taskSource)
  if (module == %error):
    ?(reject |promise| with a {{CompileError}} exception and return)
  let builtinSetNames = options.[[builtins]]
  let importedStringModule = options.[[importedStringConstants]]
  if (?([=validate builtins and imported string for a WebAssembly module|validating builtins and imported strings=] for |module| with |builtinSetNames|) && (importedStringModule == false)):
    ?(reject |promise| with a {{CompileError}} exception)
  else:
    let moduleObject = @Construct a WebAssembly module object(module, bytes, builtinSetNames, importedStringModule)
    let _ = @Resolve(promise, moduleObject)
  return promise

# compile(bytes, options)
  let stableBytes = ?(a [=get a copy of the buffer source|copy of the bytes held by the buffer=] |bytes|)
  let _ret1 = @Asynchronously compile a WebAssembly module(stableBytes, options)
  return _ret1

# instantiate imported strings(module, importedStringModule)
  assert (importedStringModule != null)
  let exportsObject = !($OrdinaryObjectCreate(SpecConst(null)))
  !(foreach (|moduleName|, |componentName|, |externtype|) in [=module_imports=](|module|))
  if (moduleName != importedStringModule):
    !(continue)
  let stringConstant = componentName
  let status = !($CreateDataProperty(Var(exportsObject)Var(stringConstant)Var(stringConstant)))
  assert (status == true)
  return exportsObject

# read the imports(module, importObject, builtinSetNames, importedStringModule)
  if (?(|module|.[=imports=] [=list/is empty|is not empty=]) && (importObject == undefined)):
    !(throw a {{TypeError}} exception)
  let builtinOrStringImports = !(map literal)
  !(foreach |builtinSetName| in |builtinSetNames|)
  let builtinSetQualifiedName = ?(|builtinSetName| prefixed with "wasm:")
  assert ?(|builtinOrStringImports| does not contain |builtinSetQualifiedName|)
  if ?(|builtinSetName| does not refer to a builtin set):
    !(continue)
  let exportsObject = @instantiate a builtin set(builtinSetName)
  builtinOrStringImports[builtinSetQualifiedName] = exportsObject
  if (importedStringModule != null):
    let exportsObject = @instantiate imported strings(module, importedStringModule)
    builtinOrStringImports[importedStringModule] = exportsObject
  let imports = []
  !(foreach (|moduleName|, |componentName|, |externtype|) in [=module_imports=](|module|))
  if ?(|builtinOrStringImports| [=map/exist|contains=] |moduleName|):
    let o = builtinOrStringImports[moduleName]
    if (!o is Object || (?(if [$HasProperty$](|o|, |componentName|)) == false)):
      let _comp1 = !($Get(Var(importObject)Var(moduleName)))
      if _comp1 is AbruptCompletion:
        return _comp1
      o = _comp1.[[Value]]
  else:
    let _comp2 = !($Get(Var(importObject)Var(moduleName)))
    if _comp2 is AbruptCompletion:
      return _comp2
    let o = _comp2.[[Value]]
  if !o is Object:
    !(throw a {{TypeError}} exception)
  let _comp3 = !($Get(Var(o)Var(componentName)))
  if _comp3 is AbruptCompletion:
    return _comp3
  let v = _comp3.[[Value]]
  if !(is of form):
    if (!($IsCallable(Var(v))) == false):
      !(throw a {{LinkError}} exception)
    if (?(|v| has a \[[FunctionAddress]] internal slot) && (?(therefore) == ?(an [=Exported Function=]))):
      let funcaddr = v.[[FunctionAddress]]
    else:
      let funcaddr = @Create a host function(v, functype)
      let index = ?(the number of external functions in |imports|)
      ?(This value |index| is known as the <dfn>index of the host function</dfn> |funcaddr|)
    let externfunc = ?(the [=external value=] [=external value|func=] |funcaddr|)
    append externfunc to imports
  if !(is of form):
    if !(implements Global):
      let globaladdr = v.[[Global]]
    else:
      if ((valtype == %i64) && !v is BigInt):
        !(throw a {{LinkError}} exception)
      if ?(|valtype| is one of [=i32=]):
        !(throw a {{LinkError}} exception)
      if (valtype == %v128):
        !(throw a {{LinkError}} exception)
      let value = @ToWebAssemblyValue(v, valtype)
      if ?(this operation throws a {{TypeError}}):
        ?(catch it, and throw a {{LinkError}} exception)
      let store = %surrounding agent.[[associated store]]
      let _tuple1 = @global_alloc(store, !(call [=const=]), value)
      let store = _tuple1[0]
      let globaladdr = _tuple1[1]
      %surrounding agent.[[associated store]] = store
    let externglobal = @external value(globaladdr)
    append externglobal to imports
  if !(is of form):
    if !(implements Memory):
      !(throw a {{LinkError}} exception)
    let externmem = _ref_Unknown.[[Memory]]
    append externmem to imports
  if !(is of form):
    if !(implements Table):
      !(throw a {{LinkError}} exception)
    let tableaddr = v.[[Table]]
    let externtable = ?(the [=external value=] [=external value|table=] |tableaddr|)
    append externtable to imports
  if !(is of form):
    assert (attribute == %tagtype/attribute/exception)
    if !(implements Tag):
      !(throw a {{LinkError}} exception)
    let tagaddr = v.[[Address]]
    let externtag = ?(the [=external value=] [=external value/tag=] |tagaddr|)
    append externtag to imports
  return imports

# create an exports object(module, instance)
  let exportsObject = !($OrdinaryObjectCreate(SpecConst(null)))
  !(foreach (|name|, |externtype|) in [=module_exports=](|module|))
  let externval = @instance_export(instance, name)
  assert (externval != %error)
  if !(is of form):
    assert !(is of form)
    let _ = !(unsupported Let lhs: AlgoCall([=external value=],List(Var(funcaddr))))
    let func = @a new Exported Function(funcaddr)
    let value = func
  if !(is of form):
    assert !(is of form)
    let _ = !(unsupported Let lhs: AlgoCall([=external value=],List(Var(globaladdr))))
    let global = @create a global object(globaladdr)
    let value = global
  if !(is of form):
    assert !(is of form)
    let _ = !(unsupported Let lhs: AlgoCall([=external value=],List(Var(memaddr))))
    let memory = @create a memory object(memaddr)
    let value = memory
  if !(is of form):
    assert !(is of form)
    let _ = !(unsupported Let lhs: AlgoCall([=external value=],List(Var(tableaddr))))
    let table = @create a Table object(tableaddr)
    let value = table
  if !(is of form):
    assert (attribute == %tagtype/attribute/exception)
    assert !(is of form)
    let _ = !(unsupported Let lhs: AlgoCall([=external value/tag=],List(Var(tagaddr))))
    let tag = @create a Tag object(tagaddr)
    let value = tag
  let status = !($CreateDataProperty(Var(exportsObject)Var(name)Var(value)))
  assert (status == true)
  let _ = @!(!($SetIntegrityLevel(Var(exportsObject)Unknown(`"frozen"`))))
  return exportsObject

# initialize an instance object(instanceObject, module, instance)
  let exportsObject = @Create an exports object(module, instance)
  instanceObject.[[Instance]] = instance
  instanceObject.[[Exports]] = exportsObject

# instantiate the core of a WebAssembly module(module, imports)
  let store = %surrounding agent.[[associated store]]
  let result = @module_instantiate(store, module, imports)
  if (result == %error):
    ?(A {{LinkError}} exception for most cases which occur during linking)
    if ?(the error came when running the start function):
      !(throw a {{RuntimeError}} for most errors which occur from WebAssembly, or the error object propagated from inner ECMAScript code)
    ?(Another error type if appropriate, for example an out-of-memory exception, as documented in <a href="#errors">the WebAssembly error mapping</a>)
  let _tuple2 = result
  let store = _tuple2[0]
  let instance = _tuple2[1]
  %surrounding agent.[[associated store]] = store
  return instance

# asynchronously instantiate a WebAssembly module(moduleObject, importObject)
  let promise = @a new promise()
  let module = moduleObject.[[Module]]
  let builtinSetNames = moduleObject.[[BuiltinSets]]
  let importedStringModule = moduleObject.[[ImportedStringModule]]
  let imports = @Read the imports(module, importObject, builtinSetNames, importedStringModule)
  if ?(this operation throws an exception):
    ?(catch it, [=reject=] |promise| with the exception, and return |promise|)
  let _ = @Queue a task()
  let instance = @Instantiate the core of a WebAssembly module(module, imports)
  if ?(this throws an exception):
    ?(catch it, [=reject=] |promise| with the exception, and terminate these substeps)
  let instanceObject = new Instance {}
  let _ = @initialize an instance object(instanceObject, module, instance)
  if ?(this throws an exception):
    ?(catch it, [=reject=] |promise| with the exception, and terminate these substeps)
  let _ = @Resolve(promise, instanceObject)
  return promise

# instantiate a promise of a module(promiseOfModule, importObject)
  let promise = @a new promise()
  let _ = @React(promiseOfModule)
  if ?(|promiseOfModule| was fulfilled with value |module|):
    let innerPromise = @asynchronously instantiate a WebAssembly module(module, importObject)
    let _ = @React(innerPromise)
    if ?(|innerPromise| was fulfilled with value |instance|):
      let result = ?(the {{WebAssemblyInstantiatedSource}} value «[ "{{WebAssemblyInstantiatedSource/module}}" → |module|, "{{WebAssemblyInstantiatedSource/instance}}" → |instance| ]»)
      let _ = @Resolve(promise, result)
    if ?(|innerPromise| was rejected with reason |reason|):
      let _ = @Reject(promise, reason)
  if ?(|promiseOfModule| was rejected with reason |reason|):
    let _ = @Reject(promise, reason)
  return promise

