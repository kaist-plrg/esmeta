    idlObject = (yet "the IDL [=interface type=] value that represents a reference to |jsValue|")
  } else nop
  let n = (sizeof args)
  if (= op.kind ~RegularOperation~) {
    call S = clo<"compute_the_effective_overload_set">(~regular operations~, id, target, n)
  } else if (= op.kind ~StaticOperation~) {
    call S = clo<"compute_the_effective_overload_set">(~static operations~, id, target, n)
  } else {
    assert false
  }
  let _tuple1 = (yet "passing |S| and |args| to the [=overload resolution algorithm=]")
  let operation = _tuple1[0]
  let values = _tuple1[1]
  let R = null
  if (= operation (yet "declared with a [{{Default}}] [=extended attribute=]")) {
    assert (yet "|operation| [=has default method steps=]")
    R = (yet "running the [=default method steps=] for |operation|, with |idlObject| as [=this=] and |values| as the argument values")
  } else {
    R = (yet "running the [=method steps=] of |operation|, with |idlObject| as [=this=] and |values| as the argument values")
  }
  call-convert _result1 = <converted_to_a_javascript_value>(R)
  if (? _result1: Completion) {
    return _result1
  } else {
    call _ret1 = clo<"NormalCompletion">(_result1)
    return _ret1
  }
  (yet "Issue(whatwg/webidl#674): |R| is assumed to be an IDL value of the type |op| is declared to return")
  (yet "And then, if <a lt=\"an exception was thrown\">an exception |E| was thrown</a>:")
  if (? (yet "|op| has a [=return type=] that"): Unknown["promise type"]) {
    call _call1 = clo<"Call">(~%Promise.reject%~, ~%Promise%~, (list [E]))
    assert (= _call1.Type ~normal~)
    let _v2 = _call1.Value
    if (? _v2: Completion) {
      return _v2
    } else {
      call _ret3 = clo<"NormalCompletion">(_v2)
      return _ret3
    }
  } else {
    (yet "end these steps and allow the exception to propagate")
  }
  call _ret4 = clo<"NormalCompletion">(~unused~)
  return _ret4
}
