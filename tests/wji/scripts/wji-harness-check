#!/bin/bash
# ------------------------------------------------------------------------------
# Usage: tests/wji/scripts/wji-harness-check [file.any.js ...]
#
# Validates tests/wji/js-api/testharness-lite.js against the real
# testharness.js, one fresh `node` subprocess per fixture for isolation. With
# no arguments, checks every spectec/test/js-api/**/*.any.js file.
#
# See wji-harness-check.js (same directory) for what this actually compares
# (our harness vs. the real one, both under Node -- not a WJI check).
# Requires Node.js on PATH.
# ------------------------------------------------------------------------------

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../../.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "error: node not found on PATH" >&2
  exit 1
fi

if [ $# -gt 0 ]; then
  files=("$@")
else
  files=()
  while IFS= read -r f; do
    files+=("$f")
  done < <(find "$repo_root/spectec/test/js-api" -name '*.any.js' | sort)
fi

fail=0
for f in "${files[@]}"; do
  if ! node "$script_dir/wji-harness-check.js" "$f"; then
    fail=1
  fi
done

exit $fail
